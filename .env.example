# ==============================================================================
# MoodCall MVP — Environment Configuration Template (.env.example)
# WARNING: Do NOT commit actual secrets or real database credentials to Git!
# ==============================================================================

# Server & Runtime Environment
NODE_ENV="development" # development | test | production
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodcall?sslmode=prefer"
# Dedicated Isolated Test Database URL (Required for integration tests)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodcall_test?sslmode=prefer"

# Cryptographic Keys (Minimum 32 random bytes in hex)
SESSION_SECRET="change_me_to_at_least_32_bytes_random_secret_hex"
FIELD_ENCRYPTION_KEY="change_me_to_32_bytes_hex_for_aes_256_gcm"
OTP_HMAC_SECRET="change_me_to_32_bytes_random_salt_for_phone_lookup_hashes"

# Provider Abstraction Flags (Strictly "mock" for Slice 1 and DEMO MODE)
OTP_PROVIDER="mock"
VERIFICATION_PROVIDER="mock"
PAYMENT_PROVIDER="mock"
STORAGE_PROVIDER="mock"
MAP_PROVIDER="mock"

# Payment Webhook HMAC Secret (DEMO)
PAYMENT_WEBHOOK_SECRET="demo_mock_payment_secret"

# Emergency Dispatch Reference (UI click-to-call tel:112 only)
EMERGENCY_PHONE_URL="tel:112"
