# ==============================================================================
# NOW / IRL — Environment Configuration Template (.env.example)
# WARNING: Do NOT commit actual secrets or real database credentials to Git!
# ==============================================================================

# Server & Runtime Environment
NODE_ENV="development" # development | test | production
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Canonical PostgreSQL Database Connection
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/now_irl_dev?sslmode=prefer"
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/now_irl_test?sslmode=prefer"

# Cryptographic Keys (Minimum 32 random bytes in hex)
SESSION_SECRET="<generate-32-random-bytes-hex>"
OTP_HMAC_SECRET="<generate-32-random-bytes-hex>"

# Authentication & Staging Mode
AUTH_MODE="dev_otp" # dev_otp (development only) | staging_gate (Railway staging) | production_sms
NEXT_PUBLIC_STAGING_MODE="false" # "true" strictly to display staging banner in UI (not used for security)
NEXT_PUBLIC_ENABLE_DEMO_MODE="true"

# Staging Gate Secrets (Required ONLY when AUTH_MODE=staging_gate)
STAGING_ACCESS_CODE="<generate-long-random-secret>"
STAGING_OTP_CODE="<generate-random-six-digit-code>"

# Staging Seed Guard (Manual single-run flag)
STAGING_SEED_ENABLED="false"

# Provider Abstraction Flags (Strictly "mock" for MVP and DEMO MODE)
OTP_PROVIDER="mock"
STORAGE_PROVIDER="mock"
MAP_PROVIDER="mock"

# Emergency Dispatch Reference (UI click-to-call tel:112 only)
EMERGENCY_PHONE_URL="tel:112"
CHAT_RETENTION_HOURS=12
