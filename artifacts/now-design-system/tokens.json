{
  "$schema": "https://tr.designtokens.org/format/",
  "$description": "Design tokens in the W3C Design Tokens (DTCG) format. THIS FILE IS THE SINGLE SOURCE OF TRUTH for the design system. Edit values here only -- do not hand-edit the generated src/index.css or src/generated/tokens.ts. The dev server regenerates them on every change (scripts/build-tokens.mjs, wired through vite.config.ts). Colors are authored as hex; the generator converts them to `H S% L%` channels for the web theme and keeps hex for mobile (tokens.ts). Every color role exists in both light and dark.",
  "color": {
    "$type": "color",
    "light": {
      "background": { "$value": "#F5F7FA" },
      "foreground": { "$value": "#08090A" },
      "border": { "$value": "#D8DDE5" },
      "card": { "$value": "#FFFFFF" },
      "cardForeground": { "$value": "#08090A" },
      "popover": { "$value": "#FFFFFF" },
      "popoverForeground": { "$value": "#08090A" },
      "primary": {
        "$value": "#2563EB",
        "$description": "Primary brand color. Drives buttons, links, and emphasis."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#E8EDF5" },
      "secondaryForeground": { "$value": "#172033" },
      "muted": { "$value": "#E9EDF2" },
      "mutedForeground": { "$value": "#5B6472" },
      "accent": { "$value": "#DCE8FF" },
      "accentForeground": { "$value": "#1747A6" },
      "destructive": { "$value": "#DC2626" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#D8DDE5" },
      "ring": { "$value": "#2563EB" },
      "chart1": { "$value": "#F59E0B" },
      "chart2": { "$value": "#2563EB" },
      "chart3": { "$value": "#22C55E" },
      "chart4": { "$value": "#A855F7" },
      "chart5": { "$value": "#EF4444" },
      "sidebar": { "$value": "#FFFFFF" },
      "sidebarForeground": { "$value": "#334155" },
      "sidebarBorder": { "$value": "#D8DDE5" },
      "sidebarPrimary": { "$value": "#2563EB" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#EAF1FF" },
      "sidebarAccentForeground": { "$value": "#1747A6" },
      "sidebarRing": { "$value": "#2563EB" }
    },
    "dark": {
      "background": { "$value": "#050608" },
      "foreground": { "$value": "#FFFFFF" },
      "border": { "$value": "#232836" },
      "card": { "$value": "#0E1014" },
      "cardForeground": { "$value": "#FFFFFF" },
      "popover": { "$value": "#151922" },
      "popoverForeground": { "$value": "#FFFFFF" },
      "primary": {
        "$value": "#4B8BFF",
        "$description": "Electric blue reserved for attention, action, and live city signals."
      },
      "primaryForeground": { "$value": "#FFFFFF" },
      "secondary": { "$value": "#151922" },
      "secondaryForeground": { "$value": "#FFFFFF" },
      "muted": { "$value": "#0E1014" },
      "mutedForeground": { "$value": "#7B8593" },
      "accent": { "$value": "#4B8BFF" },
      "accentForeground": { "$value": "#FFFFFF" },
      "destructive": { "$value": "#EF4444" },
      "destructiveForeground": { "$value": "#FFFFFF" },
      "input": { "$value": "#232836" },
      "ring": { "$value": "#78A9FF" },
      "chart1": { "$value": "#F59E0B" },
      "chart2": { "$value": "#4B8BFF" },
      "chart3": { "$value": "#22C55E" },
      "chart4": { "$value": "#A855F7" },
      "chart5": { "$value": "#EF4444" },
      "sidebar": { "$value": "#050608" },
      "sidebarForeground": { "$value": "#B7BFCA" },
      "sidebarBorder": { "$value": "#232836" },
      "sidebarPrimary": { "$value": "#4B8BFF" },
      "sidebarPrimaryForeground": { "$value": "#FFFFFF" },
      "sidebarAccent": { "$value": "#151922" },
      "sidebarAccentForeground": { "$value": "#FFFFFF" },
      "sidebarRing": { "$value": "#78A9FF" }
    }
  },
  "typography": {
    "fontFamily": {
      "$type": "fontFamily",
      "sans": {
        "$value": ["-apple-system", "BlinkMacSystemFont", "SF Pro Display", "SF Pro Text", "Segoe UI", "sans-serif"],
        "$description": "Default UI and body typeface."
      },
      "serif": { "$value": ["Georgia", "serif"] },
      "mono": { "$value": ["SFMono-Regular", "Menlo", "monospace"] }
    }
  },
  "radius": {
    "$type": "dimension",
    "base": {
      "$value": "0.75rem",
      "$description": "Base corner radius; sm/md/lg/xl derive from this in the theme."
    }
  },
  "spacing": {
    "$type": "dimension",
    "base": {
      "$value": "0.25rem",
      "$description": "Base spacing step components multiply."
    }
  }
}
